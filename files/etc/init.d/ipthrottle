#!/bin/sh /etc/rc.common
# OpenWrt init script for IPThrottle daemon

START=99
STOP=01

USE_PROCD=1

# 加载依赖检测脚本
. /usr/lib/ipthrottle/deps.sh

# 等待包管理器锁释放
# 实现原因: 服务可能在 opkg/apk 安装期间被 procd 自动启动，
# 此时包管理器锁被占。需等待锁释放后才能安装依赖。
wait_pkg_lock() {
    local lock_file=""
    local max_wait=120
    local waited=0
    
    if command -v apk >/dev/null 2>&1; then
        lock_file="/lib/apk/db/lock"
    elif command -v opkg >/dev/null 2>&1; then
        lock_file="/var/lock/opkg.lock"
    else
        return 0
    fi
    
    # 锁文件不存在 → 未锁定
    [ ! -f "$lock_file" ] && return 0
    
    # 用 flock 测试锁是否被占用（非阻塞）
    # flock -n: 成功=锁可用，失败=被占
    if ( flock -n 9 ) 9>"$lock_file" 2>/dev/null; then
        return 0  # 锁可用
    fi
    
    logger -t ipthrottle "Waiting for package manager lock..."
    while [ $waited -lt $max_wait ]; do
        sleep 2
        waited=$((waited + 2))
        # 再次测试锁
        if ( flock -n 9 ) 9>"$lock_file" 2>/dev/null; then
            logger -t ipthrottle "Lock released after ${waited}s"
            return 0
        fi
    done
    
    logger -t ipthrottle "WARNING: Lock wait timeout (${max_wait}s)"
    return 1
}

# 检测缺失依赖（只检测+警告，绝不调用包管理器安装）
# 实现原因: 依赖安装由包管理器(opkg/apk)在安装时原子完成（Makefile DEPENDS:= 声明），
#          服务运行时调用 opkg/apk 会与包管理器锁冲突导致死锁（历史 Bug）。
#          这里只做检测，缺失时输出警告+安装命令，由用户手动补装。
install_deps() {
    local pkg_mgr=""
    
    if command -v apk >/dev/null 2>&1; then
        pkg_mgr="apk"
    elif command -v opkg >/dev/null 2>&1; then
        pkg_mgr="opkg"
    fi
    
    # 尝试加载内核模块（模块可能已安装但未加载，modprobe 无副作用）
    for mod in sch_htb sch_fq_codel; do
        modprobe "$mod" 2>/dev/null
    done
    
    # 输出缺失依赖的安装指引
    logger -t ipthrottle "WARNING: Missing dependencies detected. Please install manually:"
    if [ "$pkg_mgr" = "apk" ]; then
        logger -t ipthrottle "  apk add tc-tiny nftables kmod-sched-core kmod-sched-htb kmod-ifb"
    elif [ "$pkg_mgr" = "opkg" ]; then
        logger -t ipthrottle "  opkg install tc-tiny nftables kmod-sched-core kmod-sched-htb kmod-ifb"
    else
        logger -t ipthrottle "  Install tc/nftables and required kernel modules"
    fi
    logger -t ipthrottle "  Then run: /etc/init.d/ipthrottle restart"
}

start_service() {
    # 1. 等待包管理器锁释放（如果在安装期间被自动启动）
    wait_pkg_lock
    
    # ==========================================
    # 修复 OpenWrt 25.12 cron 权限问题，自动注入定时任务
    # ==========================================
    if ! grep -q "ipthrottle schedule" /etc/crontabs/root 2>/dev/null; then
        echo "* * * * * /usr/sbin/ipthrottle schedule" >> /etc/crontabs/root
        chown root:root /etc/crontabs/root
        chmod 600 /etc/crontabs/root
        /etc/init.d/cron restart
    fi
    
    # 2. 检测并安装缺失依赖
    if ! check_all_deps >/dev/null 2>&1; then
        install_deps
    fi
    
    # 3. 再次检测（确认依赖已就绪）
    if ! check_all_deps; then
        logger -t ipthrottle "ERROR: Dependencies still missing, service may not work"
    fi
    
    # 4. 启动服务
    procd_open_instance
    procd_set_param command /usr/lib/ipthrottle/ipthrottle-daemon
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "ipthrottle"
}

reload_service() {
    /usr/sbin/ipthrottle reload
}
